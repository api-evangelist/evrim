            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "name",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The initial index from which to return the results."
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "* `str` - String\n* `int` - Integer\n* `flt` - Float\n* `bln` - Boolean\n* `rel` - Relationship\n* `enm` - Enum"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
