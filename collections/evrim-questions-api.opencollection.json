{
  "opencollection": "1.0.0",
  "info": {
    "name": "Evrim answers questions API",
    "version": "0.5.18"
  },
  "items": [
    {
      "info": {
        "name": "questions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "questions_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/prod/v0/questions/",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The initial index from which to return the results."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}